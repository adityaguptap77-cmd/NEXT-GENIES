# NextGenies Backend Environment Variables
NODE_ENV=development
PORT=5000

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION (Dual Mode: MySQL with auto-fallback to SQLite)
# ------------------------------------------------------------------------------
# To connect to your Hostinger or external MySQL database, fill in:
DB_HOST=srv1752.hstgr.io
DB_PORT=3306
DB_NAME=u228244261_Nextgenies
DB_USER=u228244261_Nextgenies
DB_PASSWORD=

# Note: If DB_HOST / DB_USER / DB_PASSWORD are not set or unreachable,
# the backend automatically uses the built-in SQLite database at: backend/data/nextgenies.db

# ------------------------------------------------------------------------------
# FRONTEND CORS & NETWORKING
# ------------------------------------------------------------------------------
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:4173,https://nextgenies.com,https://www.nextgenies.com

# ------------------------------------------------------------------------------
# ADMIN AUTHENTICATION (/admin Dashboard)
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_JWT_SECRET=nextgenies_secure_jwt_secret_key_2026

# ------------------------------------------------------------------------------
# EMAIL NOTIFICATIONS (Optional SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_TO=
