{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/contacts",
      "destination": "/server.js?route=api/contacts"
    },
    {
      "source": "/api/ping",
      "destination": "/server.js?route=api/ping"
    },
    {
      "source": "/api/health",
      "destination": "/server.js?route=api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/server.js?route=api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/server.js?route=$1"
    }
  ]
}
