{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/contacts",
      "destination": "/api/contacts.js"
    },
    {
      "source": "/api/ping",
      "destination": "/api/ping.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
